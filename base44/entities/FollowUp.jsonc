{
  "name": "FollowUp",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company (tenant isolation)"
    },
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant (new isolation)"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property"
    },
    "client_id": {
      "type": "string",
      "description": "Reference to Client"
    },
    "inspection_id": {
      "type": "string",
      "description": "Reference to related Inspection if any"
    },
    "contractor_id": {
      "type": "string",
      "description": "Reference to Contractor if applicable"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "follow_up_category": {
      "type": "string",
      "enum": [
        "urgent_issue",
        "contractor_needed",
        "general"
      ],
      "default": "general"
    },
    "type": {
      "type": "string",
      "enum": [
        "issue",
        "contractor_appointment",
        "maintenance",
        "repair",
        "inspection_followup",
        "arrival_prep",
        "departure",
        "storm_prep",
        "client_request",
        "other"
      ],
      "default": "issue"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "due_time": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_by": {
      "type": "string"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence_pattern": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "bi_weekly",
        "monthly"
      ]
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "estimated_duration_minutes": {
      "type": "number"
    },
    "billable": {
      "type": "boolean",
      "default": false
    },
    "billable_amount": {
      "type": "number"
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}