{
  "name": "TenantUser",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User"
    },
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant"
    },
    "role_in_tenant": {
      "type": "string",
      "enum": [
        "admin",
        "dispatcher",
        "field_inspector"
      ],
      "default": "field_inspector",
      "description": "User's role within this tenant"
    },
    "is_owner": {
      "type": "boolean",
      "default": false,
      "description": "Tenant owner"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "tenant_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}