{
  "name": "ChecklistTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template display name (e.g. Single Family Home)"
    },
    "template_slug": {
      "type": "string",
      "description": "Unique slug identifier (e.g. single_family_standard)."
    },
    "property_type": {
      "type": "string",
      "enum": [
        "single_family",
        "condo_villa",
        "commercial",
        "service_visit",
        "high_rise"
      ],
      "description": "Property type this template applies to"
    },
    "category": {
      "type": "string",
      "description": "Visit category (e.g. home_watch_visit, arrival_departure, emergency_visit)"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what this template covers"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Denormalized sections array [{title, items:[{label, responseType, instructions, require_note, require_photo}]}]. Primary source of truth for template content."
    },
    "checklist_instructions": {
      "type": "string",
      "description": "Instructions shown to field users at the top of the checklist"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Template version number"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this template is active and available for use"
    },
    "is_system_template": {
      "type": "boolean",
      "default": false,
      "description": "True for the 11 master system templates (tenant_id=null). Tenant copies are false."
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant this template belongs to. NULL = system master template shared across all tenants."
    }
  },
  "required": [
    "name",
    "template_slug"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "data.tenant_id": null
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}