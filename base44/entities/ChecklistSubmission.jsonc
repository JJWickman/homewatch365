{
  "name": "ChecklistSubmission",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "Reference to ChecklistTemplate"
    },
    "visit_id": {
      "type": "string",
      "description": "Reference to Visit"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property"
    },
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant"
    },
    "assigned_resource_id": {
      "type": "string",
      "description": "Reference to user completing checklist"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "submitted"
      ],
      "default": "draft",
      "description": "Submission status"
    },
    "overall_notes": {
      "type": "string",
      "description": "Overall visit notes"
    },
    "completion_percent": {
      "type": "number",
      "default": 0,
      "description": "Percentage of actionable items completed"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "template_id",
    "visit_id",
    "property_id",
    "tenant_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    },
    "read": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    },
    "update": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    }
  }
}