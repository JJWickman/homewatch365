{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "superadmin"
      ],
      "default": "user",
      "description": "User role in the platform"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed the tenant onboarding wizard"
    },
    "show_onboarding_on_startup": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show the onboarding wizard on app startup"
    }
  }
}