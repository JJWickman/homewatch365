{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "superadmin"
      ],
      "default": "user",
      "description": "User role in the platform"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed the tenant onboarding wizard"
    },
    "onboarding_dismissed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has dismissed the onboarding wizard and doesn't want to see it on startup"
    }
  },
  "required": []
}