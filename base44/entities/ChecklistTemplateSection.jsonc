{
  "name": "ChecklistTemplateSection",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "Reference to ChecklistTemplate"
    },
    "title": {
      "type": "string",
      "description": "Section title"
    },
    "description": {
      "type": "string",
      "description": "Section description"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order"
    },
    "icon": {
      "type": "string",
      "description": "Icon name (lucide-react)"
    },
    "is_collapsible": {
      "type": "boolean",
      "default": true
    },
    "metadata_json": {
      "type": "object"
    }
  },
  "required": [
    "template_id",
    "title",
    "sort_order"
  ],
  "rls": {
    "create": {
      "template_id": {
        "$in": {
          "collection": "ChecklistTemplate",
          "query": {
            "data.tenant_id": "{{user.data.primary_tenant_id}}"
          }
        }
      }
    },
    "read": {
      "template_id": {
        "$in": {
          "collection": "ChecklistTemplate",
          "query": {
            "$or": [
              {
                "data.tenant_id": "{{user.data.primary_tenant_id}}"
              },
              {
                "data.tenant_id": null
              }
            ]
          }
        }
      }
    },
    "update": {
      "template_id": {
        "$in": {
          "collection": "ChecklistTemplate",
          "query": {
            "data.tenant_id": "{{user.data.primary_tenant_id}}"
          }
        }
      }
    },
    "delete": {
      "template_id": {
        "$in": {
          "collection": "ChecklistTemplate",
          "query": {
            "$or": [
              {
                "data.tenant_id": "{{user.data.primary_tenant_id}}"
              },
              {
                "user_condition": {
                  "role": "superadmin"
                }
              }
            ]
          }
        }
      }
    }
  }
}