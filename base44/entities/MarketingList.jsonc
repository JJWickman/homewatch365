{
  "name": "MarketingList",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant (isolation)"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "clients",
        "contractors",
        "both"
      ],
      "default": "clients",
      "description": "Type of list members"
    },
    "client_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Client IDs in this list"
    },
    "contractor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Contractor IDs in this list"
    },
    "member_count": {
      "type": "integer",
      "default": 0,
      "description": "Total count of members"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tenant_id",
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    },
    "read": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    },
    "update": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}