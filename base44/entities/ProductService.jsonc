{
  "name": "ProductService",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant (isolation)"
    },
    "name": {
      "type": "string",
      "description": "Service name"
    },
    "description": {
      "type": "string"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "check-in",
        "followup",
        "pre_storm",
        "post_storm",
        "arrival_departure",
        "access_visit",
        "emergency_visit",
        "damage_recovery",
        "auto_care",
        "client_service",
        "concierge"
      ],
      "description": "Associated visit type"
    },
    "type": {
      "type": "string",
      "enum": [
        "addon"
      ],
      "description": "Type (always addon for per-visit billing)"
    },
    "base_price": {
      "type": "number",
      "description": "Price per visit"
    },
    "add_on_charges": {
      "type": "object",
      "description": "Extra charges (e.g., per extra bedroom)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tenant_id",
    "name",
    "visit_type",
    "type",
    "base_price"
  ],
  "rls": {}
}