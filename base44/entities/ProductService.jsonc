{
  "name": "ProductService",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant (isolation)"
    },
    "service_name": {
      "type": "string",
      "description": "Name of the service (e.g., Weekly Inspection, Monthly Maintenance)"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "inspection",
        "maintenance",
        "emergency",
        "concierge",
        "custom"
      ],
      "description": "Type of service"
    },
    "description": {
      "type": "string",
      "description": "Service description"
    },
    "base_price": {
      "type": "number",
      "description": "Base price for the service"
    },
    "billing_frequency": {
      "type": "string",
      "enum": [
        "one_time",
        "weekly",
        "bi_weekly",
        "monthly",
        "quarterly",
        "annually"
      ],
      "default": "monthly",
      "description": "How often this service is billed"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a recurring service"
    },
    "stripe_product_id": {
      "type": "string",
      "description": "Stripe product ID"
    },
    "stripe_price_ids": {
      "type": "object",
      "description": "Stripe price IDs for different billing frequencies"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this service is available"
    }
  },
  "required": [
    "tenant_id",
    "service_name",
    "service_type"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    },
    "read": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    },
    "update": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    },
    "delete": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    }
  }
}