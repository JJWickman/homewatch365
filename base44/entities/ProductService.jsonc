{
  "name": "ProductService",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to Tenant (isolation). NULL = system product shared across all tenants."
    },
    "name": {
      "type": "string",
      "description": "Name of the service (e.g., Weekly Inspection, Monthly Maintenance)"
    },
    "description": {
      "type": "string",
      "description": "Service description"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "check-in",
        "followup",
        "pre_storm",
        "post_storm",
        "arrival_departure",
        "access_visit",
        "emergency_visit",
        "damage_recovery",
        "auto_care",
        "client_service",
        "concierge"
      ],
      "description": "Type of visit this service represents"
    },
    "base_price": {
      "type": "number",
      "description": "Base price for the service"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this service is available"
    },
    "is_system_product": {
      "type": "boolean",
      "default": false,
      "description": "True for system products (tenant_id=null, shared across all tenants). Tenant copies are false."
    }
  },
  "required": [
    "name",
    "visit_type",
    "base_price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "data.tenant_id": null
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    }
  }
}