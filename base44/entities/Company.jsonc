{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "logo_url": {
      "type": "string",
      "description": "Company logo"
    },
    "primary_color": {
      "type": "string",
      "default": "#1e3a5f",
      "description": "Brand primary color"
    },
    "accent_color": {
      "type": "string",
      "default": "#c9a962",
      "description": "Brand accent color"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "billing_email": {
      "type": "string",
      "description": "Verified sender email for invoices"
    },
    "billing_email_verified": {
      "type": "boolean",
      "default": false
    },
    "sendgrid_sender_id": {
      "type": "string"
    },
    "google_business_url": {
      "type": "string"
    },
    "facebook_business_url": {
      "type": "string"
    },
    "yelp_business_url": {
      "type": "string"
    },
    "subscription_plan": {
      "type": "string"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "past_due",
        "cancelled"
      ],
      "default": "trial"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "marketing_addon_active": {
      "type": "boolean",
      "default": false
    },
    "stripe_connect_account_id": {
      "type": "string"
    },
    "square_account_id": {
      "type": "string"
    },
    "zelle_account": {
      "type": "string"
    },
    "venmo_username": {
      "type": "string"
    },
    "paypal_email": {
      "type": "string"
    },
    "geofencing_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Require field inspectors to be physically at the property (via GPS) to record a visit"
    },
    "geofencing_radius_meters": {
      "type": "number",
      "default": 150,
      "description": "Maximum allowed distance from property in meters (default 150m)"
    },
    "settings": {
      "type": "object",
      "description": "Company-specific settings"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}