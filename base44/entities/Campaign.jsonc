{
  "name": "Campaign",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company (tenant isolation)"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "both"
      ],
      "description": "Type of campaign"
    },
    "template_id": {
      "type": "string",
      "description": "Reference to CommunicationTemplate"
    },
    "template_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sent",
        "cancelled"
      ],
      "default": "draft",
      "description": "Campaign status"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When to send the campaign"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "all_clients",
        "selected_clients",
        "by_property_type"
      ],
      "description": "Who receives this campaign"
    },
    "recipient_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Client IDs to send to (if selected_clients)"
    },
    "property_type_filter": {
      "type": "string",
      "description": "Property type filter (if by_property_type)"
    },
    "sent_count": {
      "type": "integer",
      "default": 0
    },
    "failed_count": {
      "type": "integer",
      "default": 0
    },
    "created_by": {
      "type": "string",
      "description": "User email who created the campaign"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "name",
    "type",
    "template_id",
    "recipient_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "data.tenant_id": "{{user.data.primary_tenant_id}}"
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.primary_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}